!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Show Control Event Lists
! A Show Control event list may be one of the following types:
!     SMPTE Time Code, MIDI Time Code, Real Time Clock, Analog, Network
! 
! SMPTE/MIDI Time Code Event List
! Time stamp format is hh:mm:ss:ff (h=hour, m=minute, s=second, f=frame)
! $SCList:      List number, List type (1=MIDI, 2=SMPTE)
!               All following time code messages are in this time code list
! 
!     $$FirstFrame, $$LastFrame, $$FramesPerSecond(24, 25 or 30)
!                   (first frame and last frame are used for running the events
!                   on an internal clock or with an internal clock backup)
!     $$Source      Source device id, default=1
!     $$Internal    Internal Clock enabled
!     $$External    External Clock enabled
!     $$Silent      Silent Mode enabled
! 
! Individual Time Code Events
!   $TimeCode time stamp
!     $$SCData:   Type (E=Empty, C=Cue, M=Macro, S=Submaster),
!                   if Cue then cuelist/name
!                   if Sub then mode Off/On/Bump or F=Subfader
!                   if Macro then macro number
! 
! Real Time Clock Event List
! $SCList:      List number, List type (4=Real Time Clock)
!               All following real time clock messages are in this RTC list
!   $RtcTime:   Hours(0-23):Minutes(0-59)
!                   (If $$RtcType=0, $$RtcTime is the time of day
!                    If $$RtcType=1-4, time is the offset from sunrise or sunset
!     $$RtcType:  0=time of day (default), 1=before sunrise,
!                   2=after sunrise, 3=before sunset, 4=after sunset
!     $$RtcDate:  Date(0-31), Month(0-12), Year(0-9999)
!                   If date=0, program runs all days of month
!                   If month=0, program runs all months
!                   If year=0, program runs all years
!     $$RtcDays:  Days of week (optional)
!                   (1=Mon, 2=Tues, 3=Wed, 4=Thurs, 5=Fri, 6=Sat, 7=Sun
!                   Valid only when $$RtcDate is not used)
!     $$SCData:   Action, as above
! 
! Analog Event List
! $SCList:      List number, List type (3=Analog)
!               All following messages are in this Analog list
!   $AnalogAdx: Analog port (0-65535)
!     $$SCData: Action, as above
! 
! Network Event List
! $SCList:      List number, List type (5=Network)
!               All following event messages are in this Network list
!   $NetworkEvent: Event number
!   The following messages are for this event
!     $$DmxAddr    sACN Input address (universe/offset 1-512)
!     $$CmdString  UDP Input String
!     $$MidiString MIDI Input String
!     $$Threshold  MIDI Note Velocity Threshold
!     $$SCData:   Action, see above
 
$SCList 1 2 ! SMPTE
   Text SCList 1
   $$FirstFrame  00:00:00:00
   $$LastFrame   23:59:59:29
   $$FramesPerSecond 30
 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Macro Definitions
! 
! $MacroDef number 
! 	number = macro number 
! 
! Text label
! 	label = macro name
! 
! $$MacroMode mode  (optional)
! 	mode = 'Foreground' or 'Background' 
! 
! Options:
!    $$Data User number
!    $$Data Device name
!    $$Data Option number ! Master/Backup/All/AllButMe
!    $$Data BlinkDisable
!    $$Data Exclude (SC Learn disabled)
!    $$Data Color number ! 0=Dark 1=Red 2=Green 4=White
! 
! $$MacroContents contents
! 	contents = Eos macro commands, as listed in Eos Macro Editor,
! 	           always in English language version,
! 	           use <Enter> for Enter key
! $$MacroCommands codes (optional)
! 	codes = Eos commands codes
! 
 
$MacroDef 1
   Text Macro 1
 
   $$MacroContents Select_Last Focus Form Record Preset
 
   $$MacroCommands 86 89 873 27 119
 
$MacroDef 10
   Text Macro 10
 
   $$MacroContents Select_Last - Intensity - Color Record Preset
   $$MacroContents Attente_Enter
 
   $$MacroCommands 86 40 85 40 90 27 119 1177
 
$MacroDef 11
   Text Macro 11
 
   $$MacroContents Sub 9 0 0 @ Full Time 8 <Enter>
 
   $$MacroCommands 28 9 0 0 10 15 18 8 38
 
$MacroDef 12
   Text Macro 12
 
   $$MacroContents Sub 9 0 0 @ 0 Time 8 <Enter>
 
   $$MacroCommands 28 9 0 0 10 0 18 8 38
 
$MacroDef 13
   Text Macro 13
 
   $$MacroContents Sub 9 0 0 @ 5 0 Time 7 <Enter>
 
   $$MacroCommands 28 9 0 0 10 5 0 18 7 38
 
$MacroDef 14
   Text Macro 14
 
   $$MacroContents Select_Last Record Palette_Couleur Attente_Enter
   $$MacroContents Par_Type Nettoyer <Enter>
   $$MacroContents Label
 
   $$MacroCommands 86 27 114 1177 676 1118 38 11
 
$MacroDef 20
 
   $$MacroContents Select_Last Form - Iris - Edge - Zoom
   $$MacroContents Encodeur_Catégorie_Form - _Macros - Diffusion -
   $$MacroContents Chase_Rate - Edge_Mode Encodeur_Catégorie_Form - Chase -
   $$MacroContents Chase_Level - LED_Engine_Effects -
   $$MacroContents LED_Engine_Effect_Rate Encodeur_Catégorie_Form -
   $$MacroContents LED_Engine_Effect_Step_Time - Medium_Diffusion Record
   $$MacroContents Preset Attente_Input
 
   $$MacroCommands 86 873 40 -1 40 -1 40 -1 366 40 -1 40 -1 40 -1 40 -1
   $$MacroCommands 366 40 -1 40 -1 40 -1 40 -1 366 40 -1 40 -1 27 119 917
 
$MacroDef 131
   Text Macro 131
   $$MacroMode Background
   $$Data Color 2 ! Green
 
   $$MacroContents OSC_TX Activer <Enter>
   $$MacroContents OSC_RX Activer <Enter>
 
   $$MacroCommands 1420 833 38 236 833 38
 
$MacroDef 132
   Text Macro 132
   $$MacroMode Background
   $$Data Color 1 ! Red
 
   $$MacroContents OSC_TX Désactiver <Enter>
   $$MacroContents OSC_RX Désactiver <Enter>
 
   $$MacroCommands 1420 834 38 236 834 38
 
$MacroDef 301
   Text Macro 301
   $$MacroMode Background
   $$Data Color 2 ! Green
 
   $$MacroContents Événement 1 / Interne Activer <Enter>
 
   $$MacroCommands 491 1 57 516 833 38
 
$MacroDef 302
   Text Macro 302
   $$MacroMode Background
   $$Data Color 1 ! Red
 
   $$MacroContents Événement 1 / Interne Désactiver <Enter>
 
   $$MacroCommands 491 1 57 516 834 38
 
$MacroDef 303
   Text Macro 303
   $$MacroMode Background
   $$Data Color 3 ! Red Green
 
   $$MacroContents Événement 1 / Time 0 <Enter>
 
   $$MacroCommands 491 1 57 18 0 38
 
$MacroDef 800
 
   $$MacroContents Frame_Thrust_A Frame_Thrust_C Frame_Thrust_B
   $$MacroContents Frame_Thrust_D @ 0 <Enter>
 
   $$MacroCommands -1 -1 -1 -1 10 0 38
 
$MacroDef 817
   Text Macro 817
   $$Data Color 0 ! Dark
 
   $$MacroContents Frame_Thrust_C Frame_Thrust_A Frame_Thrust_D
   $$MacroContents Frame_Thrust_B @ 0 <Enter>
 
   $$MacroCommands -1 -1 -1 -1 10 0 38
 
$MacroDef 818
   Text Macro 818
   $$Data Color 0 ! Dark
 
   $$MacroContents Frame_Angle_C Frame_Thrust_C Frame_Angle_A
   $$MacroContents Frame_Thrust_A Frame_Angle_D Frame_Thrust_D
   $$MacroContents Frame_Angle_B Frame_Thrust_B @ 0 <Enter>
 
   $$MacroCommands -1 -1 -1 -1 -1 -1 -1 -1 10 0 38
 
$MacroDef 821
   $$MacroMode Foreground
 
   $$MacroContents Effacer_Ligne_Cmd Sneak 0 . 2 <Enter>
   $$MacroContents Effacer_Ligne_Cmd
 
   $$MacroCommands 552 23 0 39 2 38 552
 
