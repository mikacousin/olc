              <object class="GtkShortcutsShortcut" id="shift_syntax_o">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;O</property>
                <property name="title" translatable="yes" context="shortcut window">AT OUT</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="shift_syntax_h">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;H</property>
                <property name="title" translatable="yes" context="shortcut window">HOME</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="shift_syntax_l">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;L</property>
                <property name="title" translatable="yes" context="shortcut window">LOCATE</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="shift_syntax_c">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;C</property>
                <property name="title" translatable="yes" context="shortcut window">Clear command &amp; deselect</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup" id="syntax_specialized">
            <property name="visible">1</property>
            <property name="title" translatable="yes" context="shortcut window">Virtual Console &amp; Stream Deck</property>
            <child>
              <object class="GtkShortcutsShortcut" id="vc_f1_overlay">
                <property name="visible">1</property>
                <property name="accelerator">F1</property>
                <property name="title" translatable="yes" context="shortcut window">Show Shortcuts Overlay on buttons (hold)</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="vc_close">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;W</property>
                <property name="title" translatable="yes" context="shortcut window">Close Virtual Console window</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="streamdeck_syntax">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;&lt;alt&gt;C</property>
                <property name="title" translatable="yes" context="shortcut window">Stream Deck / POS syntax layer (&lt;ctrl&gt;&lt;alt&gt;[key])</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="streamdeck_shift_syntax">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;&lt;alt&gt;C</property>
                <property name="title" translatable="yes" context="shortcut window">POS syntax bypassing OS collisions (&lt;shift&gt;&lt;ctrl&gt;&lt;alt&gt;[key])</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
