<?xml version="1.0" encoding="UTF-8"?>
<interface domain="olc">
  <object class="GtkShortcutsWindow" id="help_overlay">
    <property name="modal">True</property>
    <child>
      <object class="GtkShortcutsSection"  id="shortcuts">
        <property name="visible">1</property>
        <property name="section-name">shortcuts</property>
        <property name="max-height">12</property>
        <child>
          <object class="GtkShortcutsGroup" id="general">
            <property name="visible">1</property>
            <property name="title" translatable="yes" context="shortcut window">General</property>
            <child>
              <object class="GtkShortcutsShortcut" id="fullscreen">
                <property name="visible">1</property>
                <property name="accelerator">F11</property>
                <property name="title" translatable="yes" context="shortcut window">Fullscreen</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="about">
                <property name="visible">1</property>
                <property name="accelerator">F3</property>
                <property name="title" translatable="yes" context="shortcut window">About</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="open">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;O</property>
                <property name="title" translatable="yes" context="shortcut window">Open ASCII File</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="save">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;S</property>
                <property name="title" translatable="yes" context="shortcut window">Save ASCII File</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="save_as">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;S</property>
                <property name="title" translatable="yes" context="shortcut window">Save with file name</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="patch_outputs">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;P</property>
                <property name="title" translatable="yes" context="shortcut window">Patch Outputs</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="patch_channels">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;P</property>
                <property name="title" translatable="yes" context="shortcut window">Patch Channels</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="faders">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;F</property>
                <property name="title" translatable="yes" context="shortcut window">Faders</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="edit_sequence">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;T</property>
                <property name="title" translatable="yes" context="shortcut window">Edit Sequence</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="track_channels">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;T</property>
                <property name="title" translatable="yes" context="shortcut window">Track Channels</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="independents">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;I</property>
                <property name="title" translatable="yes" context="shortcut window">Independents</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="device_inspector">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;I</property>
                <property name="title" translatable="yes" context="shortcut window">Device Inspector</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="virtual_console">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;C</property>
                <property name="title" translatable="yes" context="shortcut window">Virtual Console</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="history">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;H</property>
                <property name="title" translatable="yes" context="shortcut window">Undo History</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="quit">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;Q</property>
                <property name="title" translatable="yes" context="shortcut window">Quit</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="undo">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;Z</property>
                <property name="title" translatable="yes" context="shortcut window">Undo</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="redo">
                <property name="visible">1</property>
                <property name="accelerator">&lt;shift&gt;&lt;ctrl&gt;Z</property>
                <property name="title" translatable="yes" context="shortcut window">Redo</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="close_tab">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;W</property>
                <property name="title" translatable="yes" context="shortcut window">Close Tab</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="backspace">
                <property name="visible">1</property>
                <property name="accelerator">BackSpace</property>
                <property name="title" translatable="yes" context="shortcut window">Backspace</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup" id="move">
            <property name="visible">1</property>
            <property name="title" translatable="yes" context="shortcut window">Navigation &amp; Command Line</property>
            <child>
              <object class="GtkShortcutsShortcut" id="execute">
                <property name="visible">1</property>
                <property name="accelerator">Return</property>
                <property name="title" translatable="yes" context="shortcut window">Execute command</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="autocomplete">
                <property name="visible">1</property>
                <property name="accelerator">Tab</property>
                <property name="title" translatable="yes" context="shortcut window">Autocomplete / Switch Focus</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="clear">
                <property name="visible">1</property>
                <property name="accelerator">Escape</property>
                <property name="title" translatable="yes" context="shortcut window">Clear command &amp; selection</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="right">
                <property name="visible">1</property>
                <property name="accelerator">Right</property>
                <property name="title" translatable="yes" context="shortcut window">Next Channel / Move Right</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="left">
                <property name="visible">1</property>
                <property name="accelerator">Left</property>
                <property name="title" translatable="yes" context="shortcut window">Previous Channel / Move Left</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="up">
                <property name="visible">1</property>
                <property name="accelerator">Up</property>
                <property name="title" translatable="yes" context="shortcut window">History Prev / Move Up</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="down">
                <property name="visible">1</property>
                <property name="accelerator">Down</property>
                <property name="title" translatable="yes" context="shortcut window">History Next / Move Down</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup" id="channels">
            <property name="visible">1</property>
            <property name="title" translatable="yes" context="shortcut window">Select Channels &amp; View</property>
            <child>
              <object class="GtkShortcutsShortcut" id="filter_channels">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;F</property>
                <property name="title" translatable="yes" context="shortcut window">Toggle View Mode (All / Patched / Active)</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="all">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;A</property>
                <property name="title" translatable="yes" context="shortcut window">All active channels</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup" id="levels">
            <property name="visible">1</property>
            <property name="title" translatable="yes" context="shortcut window">Levels</property>
            <child>
              <object class="GtkShortcutsShortcut" id="+%">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;Up</property>
                <property name="title" translatable="yes" context="shortcut window">Level + %</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="-%">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;Down</property>
                <property name="title" translatable="yes" context="shortcut window">Level - %</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup" id="sequence">
            <property name="visible">1</property>
            <property name="title" translatable="yes" context="shortcut window">Sequence &amp; Playback</property>
            <child>
              <object class="GtkShortcutsShortcut" id="go">
                <property name="visible">1</property>
                <property name="accelerator">space &lt;ctrl&gt;G</property>
                <property name="title" translatable="yes" context="shortcut window">Go</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="goback">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;B</property>
                <property name="title" translatable="yes" context="shortcut window">GoBack</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="pause">
                <property name="visible">1</property>
                <property name="accelerator">&lt;ctrl&gt;space</property>
                <property name="title" translatable="yes" context="shortcut window">Toggle Pause</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="seq+">
                <property name="visible">1</property>
                <property name="accelerator">&lt;alt&gt;Down</property>
                <property name="title" translatable="yes" context="shortcut window">Next Step / Cue</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="seq-">
                <property name="visible">1</property>
                <property name="accelerator">&lt;alt&gt;Up</property>
                <property name="title" translatable="yes" context="shortcut window">Prev Step / Cue</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="rename">
                <property name="visible">1</property>
                <property name="accelerator">F2</property>
                <property name="title" translatable="yes" context="shortcut window">Rename Step / Cue / Group</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
